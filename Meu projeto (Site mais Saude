            snacks: [
                {
                    id: 'chips-batata-doce',
                    title: 'Chips de Batata Doce',
                    description: 'Petisco crocante e nutritivo assado no forno',
                    time: '30 min',
                    difficulty: 'Fácil',
                    calories: '150 kcal',
                    ingredients: ['2 batatas doces médias', '1 colher de azeite', 'Sal marinho', 'Páprica doce', 'Alecrim fresco'],
                    instructions: ['Corte as batatas em fatias finas', 'Tempere com azeite e especiarias', 'Asse a 200°C por 20-25 minutos', 'Vire na metade do tempo']
                },
                // ... mais receitas
            ],
            // ... outras categorias
        };

        // Inicialização dos SDKs
        const dataHandler = {
            onDataChanged(data) {
                allReviews = data;
                if (currentRecipeId) {
                    displayReviews(currentRecipeId);
                }
                displayRecipes();
            }
        };

        async function initializeApp() {
            // Inicializar Data SDK
            const dataResult = await window.dataSdk.init(dataHandler);
            if (!dataResult.isOk) {
                console.error("Erro ao inicializar Data SDK");
            }

            // Inicializar Element SDK
            if (window.elementSdk) {
                await window.elementSdk.init({
                    defaultConfig,
                    onConfigChange: async (config) => {
                        document.getElementById('site-title').textContent = config.site_title || defaultConfig.site_title;
                        document.getElementById('site-subtitle').textContent = config.site_subtitle || defaultConfig.site_subtitle;
                        document.getElementById('benefits-title').textContent = config.benefits_title || defaultConfig.benefits_title;
                        document.getElementById('categories-title').textContent = config.categories_title || defaultConfig.categories_title;
                    },
                    mapToCapabilities: (config) => ({
                        recolorables: [
                            {
                                get: () => config.primary_color || "#10b981",
                                set: (value) => {
                                    config.primary_color = value;
                                    window.elementSdk.setConfig({ primary_color: value });
                                }
                            }
                        ],
                        borderables: [],
                        fontEditable: {
                            get: () => config.font_family || "Inter",
                            set: (value) => {
                                config.font_family = value;
                                window.elementSdk.setConfig({ font_family: value });
                            }
                        },
                        fontSizeable: {
                            get: () => config.font_size || 16,
                            set: (value) => {
                                config.font_size = value;
                                window.elementSdk.setConfig({ font_size: value });
                            }
                        }
                    }),
                    mapToEditPanelValues: (config) => new Map([
                        ["site_title", config.site_title || defaultConfig.site_title],
                        ["site_subtitle", config.site_subtitle || defaultConfig.site_subtitle],
                        ["benefits_title", config.benefits_title || defaultConfig.benefits_title],
                        ["categories_title", config.categories_title || defaultConfig.categories_title]
                    ])
                });
            }

            setupSearch();
            showCategory('all');
        }

        // Funções principais
        function showPage(pageName) {
            // Lógica de navegação entre páginas
            document.querySelectorAll('.page-content').forEach(page => {
                page.classList.add('hidden');
            });
            
            const targetPage = document.getElementById(pageName + '-page');
            if (targetPage) {
                targetPage.classList.remove('hidden');
            }
        }

        function showCategory(category) {
            // Lógica para mostrar receitas por categoria
            if (category === 'all') {
                currentRecipes = [];
                Object.values(recipesDatabase).forEach(categoryRecipes => {
                    currentRecipes = currentRecipes.concat(categoryRecipes);
                });
            } else {
                currentRecipes = recipesDatabase[category] || [];
            }
            
            filteredRecipes = currentRecipes;
            currentPage = 1;
            displayRecipes();
        }

        function displayRecipes() {
            // Lógica para exibir receitas na tela
            const grid = document.getElementById('recipes-grid');
            const startIndex = (currentPage - 1) * recipesPerPage;
            const endIndex = startIndex + recipesPerPage;
            const recipesToShow = filteredRecipes.slice(startIndex, endIndex);
            
            grid.innerHTML = '';
            
            recipesToShow.forEach(recipe => {
                const recipeCard = document.createElement('div');
                recipeCard.className = 'recipe-card bg-white rounded-xl shadow-md hover:shadow-xl p-6 cursor-pointer';
                recipeCard.onclick = () => openRecipe(recipe);
                
                recipeCard.innerHTML = `
                    <h3 class="text-xl font-bold text-gray-800 mb-3">${recipe.title}</h3>
                    <p class="text-gray-600 text-sm mb-4">${recipe.description}</p>
                    <div class="grid grid-cols-3 gap-3 text-xs">
                        <div class="text-center">
                            <div class="font-medium text-gray-700">${recipe.time}</div>
                            <div class="text-gray-500">Preparo</div>
                        </div>
                        <div class="text-center">
                            <div class="font-medium text-gray-700">${recipe.difficulty}</div>
                            <div class="text-gray-500">Dificuldade</div>
                        </div>
                        <div class="text-center">
                            <div class="font-medium text-gray-700">${recipe.calories}</div>
                            <div class="text-gray-500">Calorias</div>
                        </div>
                    </div>
                `;
                
                grid.appendChild(recipeCard);
            });
        }

        function openRecipe(recipe) {
            // Lógica para abrir modal da receita
            currentRecipeId = recipe.id;
            const modal = document.getElementById('recipe-modal');
            
            document.getElementById('modal-title').textContent = recipe.title;
            
            const content = document.getElementById('modal-content');
            content.innerHTML = `
                <div class="mb-6">
                    <p class="text-gray-600 text-lg mb-4">${recipe.description}</p>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="text-center">
                            <div class="text-2xl mb-1">⏱️</div>
                            <div class="font-semibold">${recipe.time}</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl mb-1">📊</div>
                            <div class="font-semibold">${recipe.difficulty}</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl mb-1">🔥</div>
                            <div class="font-semibold">${recipe.calories}</div>
                        </div>
                    </div>
                </div>
                
                <div class="grid lg:grid-cols-2 gap-8">
                    <div>
                        <h4 class="font-bold text-xl mb-4">Ingredientes</h4>
                        <ul class="space-y-2">
                            ${recipe.ingredients.map(ingredient => `
                                <li class="flex items-start">
                                    <span class="text-green-500 mr-2">✓</span>
                                    <span>${ingredient}</span>
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                    
                    <div>
                        <h4 class="font-bold text-xl mb-4">Modo de Preparo</h4>
                        <ol class="space-y-3">
                            ${recipe.instructions.map((step, index) => `
                                <li class="flex items-start">
                                    <span class="bg-blue-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-sm mr-3 mt-0.5">${index + 1}</span>
                                    <span>${step}</span>
                                </li>
                            `).join('')}
                        </ol>
                    </div>
                </div>
            `;
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            displayReviews(recipe.id);
        }

        function closeModal() {
            const modal = document.getElementById('recipe-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Sistema de avaliações
        function displayReviews(recipeId) {
            const reviewsList = document.getElementById('reviews-list');
            const recipeReviews = allReviews.filter(review => review.recipe_id === recipeId);
            
            if (recipeReviews.length === 0) {
                reviewsList.innerHTML = '<p class="text-gray-500 text-center py-4">Seja o primeiro a avaliar esta receita!</p>';
                return;
            }
            
            reviewsList.innerHTML = recipeReviews.map(review => `
                <div class="border-l-4 border-blue-500 pl-4 py-2">
                    <div class="flex items-center justify-between mb-2">
                        <span class="font-medium">${review.user_name}</span>
                        <div class="rating-stars">
                            ${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)}
                        </div>
                    </div>
                    ${review.comment ? `<p class="text-gray-700 text-sm">${review.comment}</p>` : ''}
                    <p class="text-xs text-gray-500 mt-1">${new Date(review.created_at).toLocaleDateString('pt-BR')}</p>
                </div>
            `).join('');
        }

        // Event listeners
        document.addEventListener('DOMContentLoaded', function() {
            initializeApp();
            showPage('home');
        });

        // Formulário de avaliação
        document.getElementById('review-form').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (selectedRating === 0) {
                alert('Por favor, selecione uma avaliação com estrelas.');
                return;
            }
            
            const reviewerName = document.getElementById('reviewer-name').value.trim();
            const reviewComment = document.getElementById('review-comment').value.trim();
            
            if (!reviewerName) {
                alert('Por favor, digite seu nome.');
                return;
            }
            
            const reviewData = {
                recipe_id: currentRecipeId,
                user_name: reviewerName,
                rating: selectedRating,
                comment: reviewComment,
                created_at: new Date().toISOString()
            };
            
            const result = await window.dataSdk.create(reviewData);
            
            if (result.isOk) {
                alert('Avaliação enviada com sucesso!');
                document.getElementById('review-form').reset();
                selectedRating = 0;
            } else {
                alert('Erro ao enviar avaliação. Tente novamente.');
            }
        });

        // Sistema de busca
        function setupSearch() {
            const searchInput = document.getElementById('search-input');
            searchInput.addEventListener('input', function(e) {
                const searchTerm = e.target.value.toLowerCase().trim();
                if (searchTerm) {
                    performSearch(searchTerm);
                } else {
                    showCategory('all');
                }
            });
        }

        function performSearch(searchTerm) {
            let allRecipes = [];
            Object.values(recipesDatabase).forEach(categoryRecipes => {
                allRecipes = allRecipes.concat(categoryRecipes);
            });
            
            const searchResults = allRecipes.filter(recipe => {
                return recipe.title.toLowerCase().includes(searchTerm) ||
                       recipe.description.toLowerCase().includes(searchTerm) ||
                       recipe.ingredients.some(ingredient => ingredient.toLowerCase().includes(searchTerm));
            });
            
            currentRecipes = searchResults;
            filteredRecipes = searchResults;
            currentPage = 1;
            displayRecipes();
        }
    </script><!-- Rodapé -->
