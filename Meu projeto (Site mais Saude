        let selectedRating = 0;
        let currentPage = 1;
        let recipesPerPage = 9;
        let currentCategory = 'all';

        // Base de dados com 150+ receitas organizadas por categoria
        const recipesDatabase = {
            weekend: [
                {
                    id: 'pancakes-aveia',
                    title: 'Panquecas de Aveia com Frutas',
                    description: 'Panquecas nutritivas perfeitas para um café da manhã especial',
